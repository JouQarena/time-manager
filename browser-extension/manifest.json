{
  "manifest_version": 3,
  "name": "Time Manager Companion",
  "version": "0.2.0",
  "description": "Reports the active tab's domain to the local Time Manager agent and blocks sites when a limit is reached. Local only — no cloud, no telemetry.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/block-overlay.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Time Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
